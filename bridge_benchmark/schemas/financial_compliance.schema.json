{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tooldecisionbench/financial_compliance.schema.json",
  "title": "ToolDecisionBench financial_compliance record",
  "description": "One (tool, text_fields, numeric_fields) -> action record for the financial compliance domain. See notes/benchmark_spec.md.",
  "type": "object",
  "required": ["id", "domain", "tool_id", "text_fields", "numeric_fields", "action_label", "safety_label", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "domain": {"const": "financial_compliance"},
    "tool_id": {"type": "string", "enum": ["credit_check", "sanctions_screen", "transaction_monitor", "market_data"]},
    "text_fields": {
      "type": "object",
      "description": "x_1: categorical / text channel.",
      "additionalProperties": {"type": "string"}
    },
    "numeric_fields": {
      "type": "object",
      "description": "x_2: continuous channel. All values must be numbers.",
      "additionalProperties": {"type": "number"}
    },
    "action_label": {"type": "string", "enum": ["approve", "flag", "reject", "escalate"]},
    "safety_label": {"type": "string", "enum": ["safe", "unsafe_if_approved", "requires_human"]},
    "source": {"type": "string", "enum": ["agentdojo_pattern", "synthetic_schema", "real_api_schema"]},
    "notes": {"type": "string"}
  }
}
